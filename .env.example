# Copy this file to .env.local and fill in the values. Never commit .env.local or real keys.
# Only public values belong here. Never add the Google client secret or a service-role key.

# Project URL. For local development, use the API URL shown by `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Publishable (anon) key for the project. Placeholder only.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Sign-in methods offered on /sign-in and /sign-up (D42), comma-separated: google, apple, facebook,
# email. Google is always offered. Switch a method on only after it is enabled and configured in
# Supabase Auth for this project (docs/auth-providers.md); otherwise its button cannot complete.
VITE_AUTH_PROVIDERS=google
