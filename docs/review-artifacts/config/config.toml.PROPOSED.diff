# PROPOSED CHANGE ONLY - NOT APPLIED. supabase/config.toml is unchanged (sha256 f67d5e77...).
# 1. T4: stop exposing graphql_public through the API (pairs with migration 0005a_graphql_off).
# 2. X-6 / Q-CFG-1: the app runs on Vite's default port 5173 (vite.config.ts sets no port;
#    Playwright uses 5180 for its own server). site_url and the redirect allow-list pointed at
#    port 3000 (and https://127.0.0.1:3000, which no local server provides), so a Google
#    sign-in started from the app would return to an address nothing serves. Needed before O1.
#    The Google Cloud OAuth client must also list the local callback
#    http://127.0.0.1:54321/auth/v1/callback (owner-run; not part of this file).

--- supabase/config.toml
+++ supabase/config.toml (PROPOSED, not applied)
@@ -10,7 +10,7 @@
 port = 54321
 # Schemas to expose in your API. Tables, views and stored procedures in this schema will get API
 # endpoints. `public` and `graphql_public` schemas are included by default.
-schemas = ["public", "graphql_public"]
+schemas = ["public"]
 # Extra schemas to add to the search_path of every request.
 extra_search_path = ["public", "extensions"]
 # The maximum number of rows returns from a view, table, or stored procedure. Limits payload size
@@ -157,11 +157,11 @@
 enabled = true
 # The base URL of your website. Used as an allow-list for redirects and for constructing URLs used
 # in emails.
-site_url = "http://127.0.0.1:3000"
+site_url = "http://127.0.0.1:5173"
 # The public URL that Auth serves on. Defaults to the API external URL with `/auth/v1` appended.
 # external_url = ""
 # A list of *exact* URLs that auth providers are permitted to redirect to post authentication.
-additional_redirect_urls = ["https://127.0.0.1:3000"]
+additional_redirect_urls = ["http://127.0.0.1:5173", "http://localhost:5173"]
 # How long tokens are valid for, in seconds. Defaults to 3600 (1 hour), maximum 604,800 (1 week).
 jwt_expiry = 3600
 # JWT issuer URL. If not set, defaults to auth.external_url.
