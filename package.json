{
  "name": "aqs-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:functions": "node --experimental-strip-types --test supabase/functions/_shared/core.test.mjs supabase/functions/media-url/kinds.test.mjs supabase/functions/youtube-verify/verify.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "check:functions": "npx -y deno@2.5.6 check supabase/functions/invitations/index.ts supabase/functions/media-url/index.ts supabase/functions/storage-cleanup/index.ts supabase/functions/youtube-verify/index.ts",
    "check:build": "node scripts/check-production-build.mjs",
    "test:db": "bash scripts/db-sandbox/run.sh",
    "test:db:real-storage": "bash scripts/db-sandbox/run-real-storage.sh",
    "test:staging": "node tests/api/staging-checks.mjs",
    "test:staging:guards": "node --test tests/api/staging-checks.guards.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
